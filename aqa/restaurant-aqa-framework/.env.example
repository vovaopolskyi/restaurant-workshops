# Optional: use the locally installed Chrome instead of downloaded Chromium.
BROWSER_CHANNEL=
# Optional controlled-state fixtures use your AWS CLI identity, never browser credentials.
ENABLE_ADMIN_FIXTURES=false
AWS_ACCOUNT_ID=
AWS_REGION=
AWS_GUEST_SESSIONS_TABLE=
