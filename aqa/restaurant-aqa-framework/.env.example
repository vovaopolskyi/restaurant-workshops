# Supply your deployed environment; never commit the completed .env.
BASE_URL=
API_BASE_URL=
RUN_LIVE_E2E=false
OWNER_EMAIL=
OWNER_PASSWORD=
OTHER_EMAIL=
OTHER_PASSWORD=
WAITER_EMAIL=
WAITER_PASSWORD=
# Use a dedicated table at the waiter's location, capacity >= 6.
TEST_TABLE_ID=
TEST_TABLE_IDS=
